{
  "name": "buzzmaster",
  "version": "1.6.0",
  "description": "A buzzer application for quiz shows",
  "productName": "BuzzMaster",
  "author": "marvin-wtt <31454580+marvin-wtt@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/marvin-wtt/BuzzMaster"
  },
  "keywords": [
    "playstation",
    "buzz",
    "buzzer",
    "quiz"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "quasar prepare",
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"See package.json => scripts for available tests.\" && exit 0",
    "dev": "quasar dev -m electron",
    "build": "quasar build -m electron",
    "test:unit:ui": "vitest --ui",
    "test:unit": "vitest",
    "test:unit:ci": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@quasar/extras": "^2.0.2",
    "events": "^3.3.0",
    "pinia": "^4.0.2",
    "quasar": "^2.23.1",
    "vue": "^3.5.32",
    "vue-i18n": "^11.3.2",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@pinia/testing": "^2.0.1",
    "@quasar/app-vite": "^3.2.0",
    "@quasar/cli": "^5.0.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.1.1",
    "@types/w3c-web-hid": "^1.0.7",
    "@vitest/ui": "^4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.2.7",
    "autoprefixer": "^10.5.4",
    "electron-updater": "^6.8.9",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.1",
    "lodash-es": "^4.18.1",
    "prettier": "^3.9.6",
    "typed-emitter": "^2.1.0",
    "typescript": "^6.0.3",
    "vite-plugin-checker": "^0.14.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "engines": {
    "node": "^24 || ^22",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@parcel/watcher@2.5.6": true
  }
}
